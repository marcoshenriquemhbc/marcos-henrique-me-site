---
const { title, description = '', canonical = '/' } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:url" content={canonical} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:site_name" content="MARCOS HENRIQUE" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/wp-content/uploads/2025/10/cropped-Marcos-Henrique-scaled-e1761825132125-32x32.jpg" sizes="32x32" />
  <link rel="apple-touch-icon" href="/wp-content/uploads/2025/10/cropped-Marcos-Henrique-scaled-e1761825132125-180x180.jpg" />
  <meta name="google-adsense-account" content="ca-pub-5797827587542105" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5797827587542105" crossorigin="anonymous"></script>
  <style is:global>
    .article { max-width: 760px; padding: 60px 20px; }
    .post-list { list-style: none; padding: 0; }
    .post-list li { padding: 24px 0; border-bottom: 1px solid #eee; }
    .post-list h2 { font-size: 1.5em; margin-bottom: 6px; }
    .article h1 { font-size: 2.4em; }
    .article .meta { color: #69768B; font-size: 14px; }
    .article img { border-radius: 4px; margin: 20px 0; }
    .article h2 { font-size: 1.8em; margin-top: 40px; }
    :root {
      --c1: #2F7CFF; --c2: #F17C20; --c4: #69768B; --c5: #FFFFFF; --c6: #2B2D42;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: Mulish, Helvetica, Arial, sans-serif; font-weight: 300;
      font-size: 16px; line-height: 1.5; color: var(--c6); background: #fff;
    }
    a { color: var(--c1); text-decoration: none; font-weight: 600; }
    h1, h2, h3, h4, h6 { margin: 0 0 16px; font-weight: 700; color: var(--c6); line-height: 1.2; }
    h1 { font-size: 5.5em; line-height: 1.26; }
    h2 { font-size: 3em; }
    h4 { font-size: 1.4em; font-weight: 500; }
    h6 { font-size: .9em; text-transform: uppercase; letter-spacing: 1px; color: var(--c1); font-weight: 400; }
    img { max-width: 100%; height: auto; display: block; }
    section { padding: 100px 20px; }
    .wrap { max-width: 1140px; margin: 0 auto; }
    .grid { display: grid; gap: 30px; }
    .grid-2 { grid-template-columns: 1fr 1fr; align-items: center; }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .center { text-align: center; }
    .divider { width: 100px; border-bottom: 4px solid var(--c1); margin: 10px 0 20px; }
    .btn {
      display: inline-block; padding: 15px 40px; border-radius: 3px; background: var(--c1);
      color: #fff; font-weight: 600; margin: 6px; border: 0;
    }
    .btn:hover { background: #1F52A9; }
    .btn-light { background: #fff; color: var(--c6); }
    .lead { font-size: 1.2em; line-height: 1.5; }
    header.site { background: #fff; padding: 16px 20px; box-shadow: 0 0 10px rgba(23,25,39,.1); position: sticky; top: 0; z-index: 50; }
    header.site .wrap { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .logo { font-weight: 700; font-size: 22px; color: var(--c6); }
    nav ul { list-style: none; display: flex; gap: 36px; margin: 0; padding: 0; flex-wrap: wrap; }
    nav a { color: var(--c6); font-weight: 400; font-size: 16px; }
    .hero { background-size: cover; background-position: 51% 100%; color: #fff; position: relative; padding: 140px 20px; }
    .hero::before { content: ""; position: absolute; inset: 0; background: rgba(17,18,26,.6); }
    .hero .wrap { position: relative; }
    .hero h1, .hero p, .hero h2 { color: #fff; }
    .bg-dark { color: #fff; position: relative; background-size: cover; background-position: 50% 50%; }
    .bg-dark::before { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.7); }
    .bg-dark .wrap { position: relative; }
    .bg-dark h2, .bg-dark p { color: #fff; }
    .bg-dark h2 { color: var(--c2); }
    .card { padding: 20px; }
    .card img { border-radius: 4px; }
    .blog-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 4px; }
    .team-card img { width: 100%; max-width: 280px; margin: 0 auto 16px; border-radius: 4px; }
    .video { position: relative; aspect-ratio: 16/9; width: 100%; }
    .video iframe { width: 100%; height: 100%; border: 0; }
    footer.site { background: var(--c6); color: #fff; padding: 40px 20px; text-align: center; }
    footer.site p { color: #fff; margin: 0; }
    #whatsapp-float { position: fixed; bottom: 40px; right: 40px; z-index: 100; }
    #whatsapp-btn {
      display: flex; align-items: center; justify-content: center; width: 70px; height: 70px;
      background: #25d366; border-radius: 50%; box-shadow: 0 0 10px #25d366;
    }
    #whatsapp-btn:hover { background: #128c7e; }
    @media (max-width: 900px) {
      h1 { font-size: 2.5em; }
      .hero { padding: 60px 20px; }
      h2 { font-size: 2.2em; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      nav ul { gap: 18px; }
      section { padding: 60px 20px; }
    }
  </style>
</head>
<body>
  <slot />
  <div id="whatsapp-float">
    <a id="whatsapp-btn" href="https://wa.me/5521965944207?text=Ol%C3%A1%20Marcos%20Henrique!%20Gostaria%20da%20sua%20ajuda%20com%20marketing%20digital.%20Poderiamos%20conversar%20melhor%3F" target="_blank" rel="noopener noreferrer" aria-label="Fale conosco pelo WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 25" width="40" height="40"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488" fill="#fff"/></svg>
    </a>
  </div>
</body>
</html>
