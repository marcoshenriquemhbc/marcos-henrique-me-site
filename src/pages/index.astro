  .btn-primary { background: var(--c2); color: #fff; }
  .btn-outline { border: 2px solid var(--c2); color: var(--c2); }
  .btn-light { background: #ffffff; color: var(--c1); }
  .btn-whatsapp { background: #25D366; color: #ffffff; }
  .btn-whatsapp:hover { background: #128C7E; color: #ffffff; }
  .loc-badge { display: inline-flex; align-items: center; gap: 10px; margin-top: 28px; padding: 10px 18px 10px 14px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.28); color: #ffffff; font-size: 15px; backdrop-filter: blur(4px); }
  .loc-badge strong { color: #ffffff; font-weight: 700; }
  .loc-badge svg { color: #25D366; }
  .loc-badge svg.flag { color: inherit; border-radius: 2px; box-shadow: 0 0 0 1px rgba(255,255,255,.35); flex-shrink: 0; }
  .loc-pulse { width: 8px; height: 8px; border-radius: 50%; background: #25D366; box-shadow: 0 0 0 0 rgba(37,211,102,.7); animation: loc-pulse 2s infinite; }
  @keyframes loc-pulse { 0% { box-shadow: 0 0 0 0 rgba(37,211,102,.7); } 70% { box-shadow: 0 0 0 9px rgba(37,211,102,0); } 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); } }
  @media (prefers-reduced-motion: reduce) { .loc-pulse { animation: none; } }

  section { padding: 72px 0; }
  section.alt { background: var(--soft); }
  h2 { font-size: 28px; margin: 0 0 8px; }
  .divider { width: 56px; height: 3px; background: var(--c2); margin: 12px 0 28px; }
  .grid { display: grid; gap: 24px; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-2 { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .card { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 26px; }
  .card h3 { margin: 0 0 10px; font-size: 18px; }
  .card p { margin: 0; color: var(--muted); font-size: 15px; }

  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .metric { border-top: 3px solid var(--c2); padding-top: 16px; }
  .metric strong { display: block; font-size: 34px; color: var(--c2); }
  .metric span { color: var(--muted); font-size: 15px; }

  ul.check { padding-left: 0; list-style: none; }
  ul.check li { padding: 6px 0 6px 26px; position: relative; color: var(--c1); }
  ul.check li::before { content: "✓"; position: absolute; left: 0; color: var(--c2); font-weight: 700; }

  .exp { border-left: 3px solid var(--c2); padding: 4px 0 4px 20px; margin-bottom: 28px; }
